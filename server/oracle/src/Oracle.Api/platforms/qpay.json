{
  "name": "qpay",
  "description": "QQ 钱包支付 — qpay.qq.com",
  "priority": 90,
  "enabled": true,
  "matchers": [
    {"field": "domain", "operator": "contains", "value": "qpay.qq.com"}
  ],
  "extractors": [
    {"name": "qpay_url", "credential_type": "payment_url", "source": "response_body",
     "pattern": "qpay://[^\\s\"'<>)]+", "output_field": "value"},
    {"name": "payment_url", "credential_type": "payment_url", "source": "response_body",
     "pattern": "https?://qpay\\.qq\\.com/[^\\s\"'<>)]+", "output_field": "value"},
    {"name": "pay_method", "source": "request_body", "pattern": "pay_method=(\\w+)", "output_field": "pay_method"}
  ]
}
