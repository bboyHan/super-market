{
  "name": "agent-terminal",
  "version": "1.0.0",
  "description": "Agent Terminal — 凭证采集工作站",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vue\" \"sleep 3 && npm run dev:electron\"",
    "dev:server": "cd server && python -m uvicorn main:app --host 127.0.0.1 --port 8800 --reload",
    "dev:vue": "cd src && npx vite --port 5173",
    "dev:electron": "electron .",
    "build:vue": "cd src && npx vite build",
    "build:server": "cd server && pyinstaller --onefile --name agent-terminal-server main.py",
    "build": "npm run build:vue && npm run build:server"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
