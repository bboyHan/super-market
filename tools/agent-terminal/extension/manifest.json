{
  "manifest_version": 3,
  "name": "神谕 Oracle — 支付凭证采集器",
  "version": "2.0.0",
  "description": "与神谕(Oracle)本地引擎配合，自动拦截 postMessage/DOM/fetch 提取支付凭证",
  "author": "Oracle",
  "homepage_url": "http://localhost:18801",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://pay.qq.com/*",
    "https://graph.qq.com/*",
    "https://api.unipay.qq.com/*",
    "https://*.tenpay.com/*",
    "https://*.weixin.qq.com/*",
    "https://qpay.qq.com/*",
    "https://jspay.qq.com/*",
    "https://pagedoo.pay.qq.com/*",
    "http://127.0.0.1:18801/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pay.qq.com/*",
        "https://graph.qq.com/*",
        "https://qpay.qq.com/*",
        "https://jspay.qq.com/*",
        "https://*.tenpay.com/*",
        "https://pagedoo.pay.qq.com/*"
      ],
      "js": ["platforms/qq_midas.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oracle Collector"
  }
}
